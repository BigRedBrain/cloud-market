# Cloud Market — environment template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit real secrets.
# Every variable here is validated by `lib/env.ts` at startup.

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection, used by the application at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/cloudmarket?sslmode=require"
# Direct connection, used by drizzle-kit for migrations. DDL over a pooler can
# fail part-way through; Neon exposes this as the non-pooled host.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cloudmarket?sslmode=require"

# --- Auth.js (Phase 1) -------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Public runtime ----------------------------------------------------------
# Canonical origin. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (Phase 3; PRIVATE STORE from Phase 5) -----------------------
# Read-write token for the Blob store product media lives in.
#
# THE STORE MUST SUPPORT PRIVATE OBJECTS. Every upload is written with
# `access: 'private'` (see lib/media/constants.ts), and `finalizeUploadAction`
# DELETES any object that did not land on `*.private.blob.vercel-storage.com`
# rather than recording it. A token pointing at a public-only store therefore
# fails uploads loudly instead of quietly making the catalog world-readable.
#
# Reads use this token too: media is served through /api/media/<id> after a
# session check, so the server needs it to fetch the bytes. Without it, uploads
# and media both fail — nothing degrades to public.
BLOB_READ_WRITE_TOKEN=""

# --- Google Maps Platform (Phase 7) ------------------------------------------
# Browser key. Restrict by HTTP referrer in Google Cloud Console — it is public.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key for geocoding and distance matrix. Restrict by IP. Never exposed.
GOOGLE_MAPS_SERVER_API_KEY=""

# --- Checkout & orders (Phase 4) ---------------------------------------------
# The checkout kill switch. A STRING compared against the literal "true";
# anything else — including "1", "yes" and "TRUE" — and absence both mean OFF.
# Disabled stops draft creation and order placement only: browsing, the bag,
# accounts, existing-order viewing and staff fulfilment keep working.
CHECKOUT_ENABLED="false"

# Shared secret for the scheduled expired-draft sweep. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. 32+ random bytes; mark it Sensitive.
# Unset, /api/cron/sweep-drafts returns 503 and does NOT run unauthenticated.
CRON_SECRET=""

# Declares the target for `npm run db:seed:limits:dev`. Only "development" and
# "staging" are accepted; absent, empty or anything else refuses before the
# script opens a connection. There is deliberately NO value meaning production —
# production purchase-limit rules are published only through
# /admin/purchase-limits, and publishing one cannot be undone.
SEED_TARGET_ENVIRONMENT=""

# --- Administrative identity (Phase 5) ---------------------------------------
# THE OWNER. The immutable `users.id` UUID of the permanent administrator, read
# from the SERVER environment and never from the database.
#
# CloudMarket has at most TWO administrators: the account named here, and the
# single optional occupant of the `admin_backup` slot. Holding
# `users.role = 'admin'` is NOT sufficient on its own — see
# lib/auth/admin-identity.ts.
#
# FAILS CLOSED. If this is unset or is not a valid UUID, EVERY administrator is
# denied, including the owner. That is deliberate: falling back to a role check
# would silently downgrade to the weaker model this replaced.
#
# NEVER prefix this with NEXT_PUBLIC_. Publishing which account is permanently
# privileged is the single most useful fact an attacker could learn here.
# There is no UI anywhere that changes this value; ownership transfer means
# editing it in the deployment environment.
CLOUDMARKET_OWNER_USER_ID=""

# --- Invite-only registration (Phase 5) --------------------------------------
# Server-only pepper for invite-code digests. 32+ random characters.
#
# A PEPPER, NOT A SALT: it lives here rather than beside the digest in the
# database, so a dump of `invite_codes` alone cannot be verified against
# candidate codes. Invite codes carry 140 bits of entropy, so this is defence in
# depth — but it is what makes a stolen table worthless without the app.
#
# ROTATING IT INVALIDATES EVERY OUTSTANDING INVITE. Occasionally that is exactly
# what you want. Unset, invite issuance and redemption both fail closed, which
# means registration is closed.
INVITE_CODE_PEPPER=""

# --- Crypto payments (Phase 5) -----------------------------------------------
# The crypto kill switch. A STRING compared against the literal "true", for the
# same reason CHECKOUT_ENABLED is one: `z.coerce.boolean()` treats every
# non-empty string as true, so "false" would ENABLE it.
#
# MUST REMAIN "false" UNTIL A PROVIDER IS SELECTED AND APPROVED. With it off,
# the webhook endpoint returns 404 and no invoice can be created.
CRYPTO_PAYMENTS_ENABLED="false"

# Which provider adapter to use. Only "mock" is implemented; "btcpay" and
# "coinbase_commerce" are reserved enum values with no adapter behind them yet.
#
# "mock" IS REFUSED IN PRODUCTION by lib/payments/gate.ts, so a typo here cannot
# select the fake provider — the one that marks invoices paid on request — where
# real money is. Unset, the gate stays closed even with the flag on.
CRYPTO_PAYMENT_PROVIDER=""

# HMAC secret the mock provider signs webhooks with. Test infrastructure only;
# never set this in production. The Phase 5 suites default it themselves.
MOCK_PAYMENT_WEBHOOK_SECRET=""
