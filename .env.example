# Cloud Market — environment template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit real secrets.
# Every variable here is validated by `lib/env.ts` at startup.

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection, used by the application at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/cloudmarket?sslmode=require"
# Direct connection, used by drizzle-kit for migrations. DDL over a pooler can
# fail part-way through; Neon exposes this as the non-pooled host.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cloudmarket?sslmode=require"

# --- Auth.js (Phase 1) -------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Public runtime ----------------------------------------------------------
# Canonical origin. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (Phase 3) ---------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Google Maps Platform (Phase 7) ------------------------------------------
# Browser key. Restrict by HTTP referrer in Google Cloud Console — it is public.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key for geocoding and distance matrix. Restrict by IP. Never exposed.
GOOGLE_MAPS_SERVER_API_KEY=""

# --- Checkout & orders (Phase 4) ---------------------------------------------
# The checkout kill switch. A STRING compared against the literal "true";
# anything else — including "1", "yes" and "TRUE" — and absence both mean OFF.
# Disabled stops draft creation and order placement only: browsing, the bag,
# accounts, existing-order viewing and staff fulfilment keep working.
CHECKOUT_ENABLED="false"

# Shared secret for the scheduled expired-draft sweep. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. 32+ random bytes; mark it Sensitive.
# Unset, /api/cron/sweep-drafts returns 503 and does NOT run unauthenticated.
CRON_SECRET=""

# Declares the target for `npm run db:seed:limits:dev`. Only "development" and
# "staging" are accepted; absent, empty or anything else refuses before the
# script opens a connection. There is deliberately NO value meaning production —
# production purchase-limit rules are published only through
# /admin/purchase-limits, and publishing one cannot be undone.
SEED_TARGET_ENVIRONMENT=""
