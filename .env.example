# Cloud Market — environment template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit real secrets.
# Every variable here is validated by `lib/env.ts` at startup.

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection, used by the application at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/cloudmarket?sslmode=require"
# Direct connection, used by drizzle-kit for migrations. DDL over a pooler can
# fail part-way through; Neon exposes this as the non-pooled host.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cloudmarket?sslmode=require"

# --- Auth.js (Phase 1) -------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Public runtime ----------------------------------------------------------
# Canonical origin. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (Phase 3) ---------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Google Maps Platform (Phase 7) ------------------------------------------
# Browser key. Restrict by HTTP referrer in Google Cloud Console — it is public.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key for geocoding and distance matrix. Restrict by IP. Never exposed.
GOOGLE_MAPS_SERVER_API_KEY=""
